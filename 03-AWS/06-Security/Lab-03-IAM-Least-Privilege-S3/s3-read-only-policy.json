{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListBucketOnly",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::meu-bucket-lab-exclusivo"
        },
        {
            "Sid": "AllowGetObjectOnly",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::meu-bucket-lab-exclusivo/*"
        }
    ]
}
